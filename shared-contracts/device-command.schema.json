{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecare.local/contracts/device-command.schema.json",
  "title": "Authorized Device Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executionMode", "authorizationId", "participantId", "deviceId", "durationSec", "frequencyHz",
    "intensityPct", "algorithmVersion", "issuedAt", "expiresAt", "idempotencyKey"
  ],
  "properties": {
    "executionMode": { "const": "SIMULATOR_ONLY" },
    "authorizationId": { "type": "string", "minLength": 1 },
    "participantId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "durationSec": { "type": "integer", "minimum": 1 },
    "frequencyHz": { "type": "integer", "minimum": 1 },
    "intensityPct": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Device's own output setting in percent. This is a device-relative command, not a measured acceleration, displacement, or power value. The physical output mapping requires device calibration." },
    "targetAccelerationG": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 16 }
  }
}
