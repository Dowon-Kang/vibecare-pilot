{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalMeasurementV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "sourceId",
    "deviceId",
    "measuredAt",
    "values"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weightKg",
        "bodyFatPct",
        "fatMassKg",
        "muscleKg"
      ],
      "properties": {
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "bodyFatPct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 100
        },
        "fatMassKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "muscleKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      }
    }
  }
}
