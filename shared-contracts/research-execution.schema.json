{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot-0.6.0 research execution boundary",
  "description": "Subset of a recommendation response. READY status is simulator eligibility only. Physical READY is reserved for a future approved version, not accepted here.",
  "type": "object",
  "required": ["algorithmVersion", "status", "executionStatus", "realDeviceSendAllowed", "reasonCodes", "evidence"],
  "properties": {
    "algorithmVersion": {"const": "pilot-0.6.0"},
    "status": {"enum": ["READY", "REVIEW", "BLOCKED"]},
    "executionStatus": {"enum": ["REVIEW", "BLOCKED", "CALIBRATION_REQUIRED", "INSUFFICIENT_DATA"]},
    "realDeviceSendAllowed": {"const": false},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "required": ["muscleIndex", "thresholds", "protocol", "averaging", "boundaryReview", "physicalEquation"],
      "properties": {
        "muscleIndex": {"const": "INDIRECT"},
        "thresholds": {"const": "INDIRECT"},
        "protocol": {"const": "PILOT"},
        "averaging": {"const": "PILOT"},
        "boundaryReview": {"const": "PILOT"},
        "physicalEquation": {"const": "EVIDENCE"}
      }
    }
  }
}
