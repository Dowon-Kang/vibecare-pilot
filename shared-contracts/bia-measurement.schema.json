{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecare.local/contracts/bia-measurement.schema.json",
  "title": "BIA Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "participantId",
    "measuredAt",
    "deviceId",
    "qualityPassed",
    "muscleDefinition",
    "definitionRef",
    "muscleMeasurementMethod",
    "methodEvidenceRef",
    "muscleMassUnit",
    "acquisitionProtocol",
    "values"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "participantId": {
      "type": "string",
      "minLength": 1
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "qualityPassed": {
      "type": "boolean"
    },
    "muscleDefinition": { "type": "string", "enum": ["UNKNOWN", "ASM", "SMM"] },
    "definitionRef": { "type": "string", "minLength": 1 },
    "muscleMeasurementMethod": { "type": "string", "minLength": 1 },
    "methodEvidenceRef": { "type": "string", "minLength": 1 },
    "muscleMassUnit": { "const": "kg" },
    "acquisitionProtocol": { "type": "string", "minLength": 1 },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weightKg",
        "bmi",
        "bodyFatPct",
        "fatMassKg",
        "skeletalMuscleMassKg"
      ],
      "properties": {
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bmi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodyFatPct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fatMassKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "skeletalMuscleMassKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basalMetabolicRateKcal": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "bodyWaterPct": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "proteinKg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mineralKg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ecwRatio": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "waistCm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "visceralFatLevel": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
