{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "provider": "FITRUS",
  "baseUrl": "https://api.thefitrus.com/fitrus-ml/measure",
  "method": "POST",
  "authentication": {
    "location": "header",
    "headerName": "x-api-key",
    "storage": "server-secret-only"
  },
  "endpoints": {
    "bloodPressure": "/bp",
    "heartRate": "/hr",
    "stress": "/stress",
    "bodyTemperature": "/bodytemp",
    "bodyFat": "/bodyfat",
    "stressV2": "/stress2"
  },
  "requestSchemas": {
    "status": "CONFIRMED",
    "source": "../measure-api-guide.md",
    "implementation": "../backend-api/src/fitrus-contract.ts",
    "remaining": "PPG sample count and item range are device-spec dependent"
  },
  "responseSchemas": {
    "status": "CONFIRMED",
    "source": "../measure-api-guide.md",
    "implementation": "../backend-api/src/fitrus-contract.ts",
    "remaining": "Numeric units, valid ranges, and body-composition method definitions are not specified"
  }
}
