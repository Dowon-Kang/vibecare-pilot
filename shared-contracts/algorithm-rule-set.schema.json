{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecare.local/contracts/algorithm-rule-set.schema.json",
  "title": "Algorithm Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "activeFrom",
    "enabled",
    "base",
    "age",
    "sex",
    "bodyFat",
    "muscle",
    "output",
    "research"
  ],
  "properties": {
    "version": {
      "const": "pilot-0.6.0"
    },
    "activeFrom": {
      "type": "string",
      "format": "date-time"
    },
    "enabled": {
      "type": "boolean"
    },
    "base": {
      "type": "object",
      "required": [
        "durationSec",
        "frequencyHz",
        "intensityPct"
      ],
      "properties": {
        "durationSec": {
          "type": "integer",
          "minimum": 1
        },
        "frequencyHz": {
          "type": "integer",
          "minimum": 1
        },
        "intensityPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "age": {
      "type": "object",
      "required": [
        "threshold",
        "factor"
      ],
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100
        },
        "factor": {
          "const": 1
        }
      }
    },
    "sex": {
      "type": "object",
      "required": [
        "femaleFactor",
        "maleFactor"
      ],
      "properties": {
        "femaleFactor": {
          "const": 1
        },
        "maleFactor": {
          "const": 1
        }
      }
    },
    "bodyFat": {
      "type": "object",
      "required": [
        "female",
        "male",
        "outsideRangeFactor"
      ],
      "properties": {
        "female": {
          "$ref": "#/$defs/range"
        },
        "male": {
          "$ref": "#/$defs/range"
        },
        "outsideRangeFactor": {
          "const": 1
        }
      }
    },
    "muscle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "female",
        "male",
        "protocols"
      ],
      "properties": {
        "female": {
          "$ref": "#/$defs/muscleThresholds"
        },
        "male": {
          "$ref": "#/$defs/muscleThresholds"
        },
        "protocols": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium",
            "reference"
          ],
          "properties": {
            "low": {
              "$ref": "#/$defs/protocol"
            },
            "medium": {
              "$ref": "#/$defs/protocol"
            },
            "reference": {
              "$ref": "#/$defs/protocol"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "minimumPct",
        "maximumPct"
      ],
      "properties": {
        "minimumPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximumPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "measurementDefinition",
        "protocolEvidence"
      ],
      "properties": {
        "mode": {
          "const": "simulation_only"
        },
        "measurementDefinition": {
          "const": "unverified"
        },
        "protocolEvidence": {
          "const": "PILOT"
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "muscleThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowMaximum",
        "mediumMaximum"
      ],
      "properties": {
        "lowMaximum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mediumMaximum": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSec",
        "frequencyHz",
        "intensityPct"
      ],
      "properties": {
        "durationSec": {
          "type": "integer",
          "minimum": 1
        },
        "frequencyHz": {
          "type": "integer",
          "minimum": 1
        },
        "intensityPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
