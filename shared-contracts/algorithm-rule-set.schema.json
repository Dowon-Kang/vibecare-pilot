{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecare.local/contracts/algorithm-rule-set.schema.json",
  "title": "VibeCare simulator rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "activeFrom", "enabled", "research", "measurementPolicy", "muscle", "output"],
  "properties": {
    "version": { "const": "pilot-0.7.0" },
    "activeFrom": { "type": "string", "format": "date-time" },
    "enabled": { "const": true },
    "research": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "protocolEvidence", "physicalExecution"],
      "properties": {
        "mode": { "const": "simulation_only" },
        "protocolEvidence": { "const": "HYPOTHESIS_UNVALIDATED" },
        "physicalExecution": { "const": "PROHIBITED" }
      }
    },
    "measurementPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumAgeDays", "maximumFutureSkewMinutes", "requiredUnit", "requireSameMethod", "requireSameAcquisitionProtocol", "policyBasis"],
      "properties": {
        "maximumAgeDays": { "type": "integer", "minimum": 1 },
        "maximumFutureSkewMinutes": { "type": "integer", "minimum": 0 },
        "requiredUnit": { "const": "kg" },
        "requireSameMethod": { "const": true },
        "requireSameAcquisitionProtocol": { "const": true },
        "policyBasis": { "const": "ENGINEERING_POLICY" }
      }
    },
    "muscle": {
      "type": "object", "additionalProperties": false,
      "required": ["definitions", "simulatorCandidates"],
      "properties": {
        "definitions": {
          "type": "object", "additionalProperties": false, "required": ["ASM", "SMM"],
          "properties": {
            "ASM": { "$ref": "#/$defs/asmDefinition" },
            "SMM": { "$ref": "#/$defs/smmDefinition" }
          }
        },
        "simulatorCandidates": {
          "type": "object", "additionalProperties": false, "required": ["low", "medium", "reference"],
          "properties": {
            "low": { "$ref": "#/$defs/candidate" },
            "medium": { "$ref": "#/$defs/candidate" },
            "reference": { "$ref": "#/$defs/candidate" }
          }
        }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["minimumPct", "maximumPct"],
      "properties": { "minimumPct": { "type": "number", "minimum": 0, "maximum": 100 }, "maximumPct": { "type": "number", "minimum": 0, "maximum": 100 } }
    }
  },
  "$defs": {
    "thresholds": {
      "type": "object", "additionalProperties": false, "required": ["lowMaximum", "mediumMaximum"],
      "properties": { "lowMaximum": { "type": "number", "exclusiveMinimum": 0 }, "mediumMaximum": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "sexThresholds": {
      "type": "object", "additionalProperties": false, "required": ["female", "male", "classificationEvidence", "applicableMethods"],
      "properties": {
        "female": { "$ref": "#/$defs/thresholds" }, "male": { "$ref": "#/$defs/thresholds" },
        "classificationEvidence": { "enum": ["HYPOTHESIS_UNVALIDATED", "INDIRECT"] },
        "applicableMethods": { "type": "array", "items": { "$ref": "#/$defs/applicableMethod" } }
      }
    },
    "applicableMethod": {
      "type": "object", "additionalProperties": false, "required": ["method", "methodEvidenceRef", "definitionRef"],
      "properties": { "method": { "type": "string", "minLength": 1 }, "methodEvidenceRef": { "type": "string", "minLength": 1 }, "definitionRef": { "type": "string", "minLength": 1 } }
    },
    "asmDefinition": {
      "allOf": [{ "$ref": "#/$defs/sexThresholds" }, { "properties": { "classificationEvidence": { "const": "HYPOTHESIS_UNVALIDATED" } } }]
    },
    "smmDefinition": {
      "allOf": [{ "$ref": "#/$defs/sexThresholds" }, { "properties": { "classificationEvidence": { "const": "INDIRECT" } } }]
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["durationSec", "frequencyHz", "intensityPct", "evidence"],
      "properties": {
        "durationSec": { "type": "integer", "minimum": 1 }, "frequencyHz": { "type": "integer", "minimum": 1 },
        "intensityPct": { "type": "number", "minimum": 0, "maximum": 100 }, "evidence": { "const": "HYPOTHESIS_UNVALIDATED" }
      }
    }
  }
}
