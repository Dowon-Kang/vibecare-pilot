# Server-side only. Copy the Session pooler URI from Supabase Dashboard > Connect.
# Never put this value in Flutter, Git, logs, or --dart-define.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SCHEMA=vibecare
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5
ENVIRONMENT=development
ALLOW_DEVELOPMENT_SEED=false
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
FITRUS_API_BASE_URL=https://api.thefitrus.com/fitrus-ml/measure
FITRUS_API_KEY=
DEVICE_MODE=mock
REAL_DEVICE_ENABLED=false
PORT=8787
