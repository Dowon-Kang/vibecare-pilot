{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecare.local/contracts/bia-measurement.schema.json",
  "title": "BIA Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "participantId", "measuredAt", "deviceId", "qualityPassed", "values"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "participantId": { "type": "string", "minLength": 1 },
    "measuredAt": { "type": "string", "format": "date-time" },
    "deviceId": { "type": "string", "minLength": 1 },
    "qualityPassed": { "type": "boolean" },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weightKg", "bmi", "bodyFatPct", "fatMassKg", "skeletalMuscleMassKg"
      ],
      "properties": {
        "weightKg": { "type": "number", "exclusiveMinimum": 0 },
        "bmi": { "type": "number", "exclusiveMinimum": 0 },
        "bodyFatPct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "fatMassKg": { "type": "number", "minimum": 0 },
        "skeletalMuscleMassKg": { "type": "number", "exclusiveMinimum": 0 },
        "basalMetabolicRateKcal": { "type": "number", "exclusiveMinimum": 0 },
        "bodyWaterPct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "proteinKg": { "type": "number", "minimum": 0 },
        "mineralKg": { "type": "number", "minimum": 0 },
        "ecwRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "waistCm": { "type": "number", "exclusiveMinimum": 0 },
        "visceralFatLevel": { "type": "number", "minimum": 0 }
      }
    }
  }
}
